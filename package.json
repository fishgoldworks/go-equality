{
  "name": "go-equality",
  "version": "2.0.0",
  "private": true,
  "description": "Deep equality with strict and loose modes, circular-reference support, and custom comparison rules.",
  "license": "MIT",
  "author": "Michael Ko",
  "email": "koyote130708@gmail.com",
  "keywords": [
    "equal",
    "deep equal",
    "loose equal",
    "strict equal",
    "loosely equal",
    "strictly equal",
    "equality",
    "deep equality",
    "loose equality",
    "strict equality",
    "equality check",
    "check equality"
  ],
  "homepage": "https://github.com/koyote130708/go-equality",
  "repository": {
    "type": "git",
    "url": "https://github.com/koyote130708/go-equality.git"
  },
  "engines": {
    "node": ">=8.0.0"
  },
  "main": "index.js",
  "scripts": {
    "build": "node scripts/build.js",
    "docs": "node scripts/docs.js",
    "pack:package": "node scripts/pack-package.js",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "node scripts/test.js",
    "test:docs": "node scripts/docs.js --check && node --test scripts/test-docs.js",
    "test:types": "node scripts/test-types.js",
    "test:build": "node --test scripts/test-build.js",
    "test:tooling": "node --test scripts/test-tooling.js",
    "test:artifacts": "node scripts/test-artifacts.js",
    "test:loaders": "node scripts/test-loaders.js",
    "test:package": "node scripts/test-package.js",
    "test:release": "node --test scripts/test-release.js",
    "test:browser": "python scripts/test-browser.py",
    "test:memory": "node scripts/test-memory.js",
    "test:stress": "node scripts/stress.js",
    "coverage": "npm test -- --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100",
    "verify": "node scripts/verify.js",
    "verify:all": "node scripts/verify.js --browser",
    "benchmark": "node scripts/benchmark.js",
    "benchmark:custom": "node scripts/benchmark-custom.js",
    "benchmark:memory": "node scripts/benchmark-memory.js",
    "prepack": "node scripts/root-package-guard.js",
    "prepublishOnly": "node scripts/root-package-guard.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "acorn": "8.15.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-no-only-tests": "3.4.0",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "terser": "5.51.2",
    "typescript": "5.8.3",
    "typescript-eslint": "8.70.1"
  }
}
