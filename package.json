{
  "name": "go-equality",
  "description": "Equality checking functions that work for both primitive types and objects, including nested objects and cyclic objects with a circular reference.",
  "author": "Michael Ko",
  "email": "koyote130708@gmail.com",
  "version": "2.0.0",
  "license": "LGPL-3.0-only",
  "keywords": [
    "equal",
    "deep equal",
    "loose equal",
    "strict equal",
    "loosely equal",
    "strictly equal",
    "equality",
    "deep equality",
    "loose equality",
    "strict equality",
    "equality check",
    "check equality"
  ],
  "homepage": "https://github.com/koyote130708/go-equality",
  "repository": {
    "type": "git",
    "url": "https://github.com/koyote130708/go-equality.git"
  },
  "main": "index.js",
  "scripts": {
    "build": "node scripts/build.js",
    "docs": "node scripts/docs.js",
    "test": "node scripts/test.js",
    "test:docs": "node scripts/docs.js --check && node --test scripts/test-docs.js",
    "test:types": "tsc --project test/types/tsconfig.json",
    "test:build": "node --test scripts/test-build.js",
    "test:artifacts": "node scripts/test-artifacts.js",
    "test:loaders": "node scripts/test-loaders.js",
    "test:package": "node scripts/test-package.js",
    "test:memory": "node scripts/test-memory.js",
    "test:stress": "node scripts/stress.js",
    "test:browser": "python scripts/test-browser.py",
    "coverage": "npm test -- --experimental-test-coverage --test-coverage-include=\"src/**\"",
    "verify": "npm run lint && npm run format:check && npm run build && npm run test:docs && npm run coverage && npm run test:types && npm run test:build && npm run test:artifacts && npm run test:package && npm run test:memory",
    "verify:all": "npm run verify && npm run test:browser",
    "benchmark": "node scripts/benchmark.js",
    "benchmark:custom": "node scripts/benchmark-custom.js",
    "benchmark:memory": "node scripts/benchmark-memory.js",
    "prepack": "npm run verify",
    "prepublishOnly": "npm run verify:all",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "devDependencies": {
    "acorn": "8.15.0",
    "terser": "5.51.2",
    "typescript": "5.8.3",
    "@fishgold/eslint-config": "file:vendor/fishgold-eslint-config-0.2.0.tgz",
    "eslint": "10.11.0",
    "prettier": "3.9.6",
    "typescript-eslint": "8.70.1"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "types": "index.d.ts",
  "sideEffects": false,
  "files": [
    "index.js",
    "index.d.ts",
    "src/*.js",
    "dist/go-equality.js",
    "dist/go-equality.min.js",
    "README.md",
    "LICENSE.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./dist/go-equality.js": "./dist/go-equality.js",
    "./dist/go-equality.min.js": "./dist/go-equality.min.js",
    "./package.json": "./package.json"
  }
}
